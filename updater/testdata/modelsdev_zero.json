{
  "xiaomi-token-plan-cn": {
    "id": "xiaomi-token-plan-cn",
    "env": [
      "XIAOMI_API_KEY"
    ],
    "npm": "@ai-sdk/openai-compatible",
    "api": "https://token-plan-cn.xiaomimimo.com/v1",
    "name": "Xiaomi Token Plan (China)",
    "doc": "https://platform.xiaomimimo.com/#/docs",
    "models": {
      "mimo-v2.6-flash": {
        "id": "mimo-v2.6-flash",
        "name": "MiMo-V2.6-Flash",
        "description": "MiMo Flash model for multimodal coding agents and long-context automation",
        "family": "mimo",
        "attachment": true,
        "reasoning": true,
        "reasoning_options": [
          {
            "type": "toggle"
          }
        ],
        "tool_call": true,
        "interleaved": {
          "field": "reasoning_content"
        },
        "temperature": true,
        "release_date": "2026-09-22",
        "last_updated": "2026-09-22",
        "modalities": {
          "input": [
            "text",
            "image",
            "audio",
            "video"
          ],
          "output": [
            "text"
          ]
        },
        "open_weights": true,
        "limit": {
          "context": 1048576,
          "output": 131072
        },
        "cost": {
          "input": 0,
          "output": 0,
          "cache_read": 0
        }
      }
    }
  }
}
